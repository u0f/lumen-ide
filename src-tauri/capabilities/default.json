{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local editor window; files and processes are handled by scoped Rust commands.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-destroy", "core:window:allow-close", "core:window:allow-set-title", "core:window:allow-set-fullscreen", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-internal-toggle-maximize", "core:window:allow-start-dragging", "core:window:allow-is-maximized"]
}
