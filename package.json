{
  "name": "lumen-ide",
  "version": "1.1.0",
  "description": "A lightweight desktop IDE built with Rust and Tauri",
  "license": "MIT",
  "repository": "github:u0f/lumen-ide",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json && node e2e/app.mjs src-tauri/target/debug/lumen-ide.exe"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.17",
    "lucide": "^0.468.0",
    "marked": "^18.1.3",
    "monaco-editor": "^0.55.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.5.438"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/papaparse": "^5.5.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
